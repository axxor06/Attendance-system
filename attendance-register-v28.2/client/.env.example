# Local browser on the development PC:
VITE_API_BASE_URL=http://localhost:5000/api

# LAN browser on another device: replace YOUR_PC_LAN_IP with the PC's current
# private IPv4 address, for example http://192.168.1.28:5000/api.
# VITE_API_BASE_URL=http://YOUR_PC_LAN_IP:5000/api

# Vite listens on all interfaces by default for LAN development.
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
