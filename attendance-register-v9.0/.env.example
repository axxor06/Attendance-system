# Root-level Docker Compose example. Never commit a real .env file.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongo:27017/attendance_system_v3
CLIENT_URL=https://app.example.edu
ALLOWED_ORIGINS=https://app.example.edu
TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET=replace-with-a-random-64-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=true

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-me
EMAIL_PASS=replace-me
EMAIL_FROM="Attendance System <noreply@example.edu>"

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OTP_GENERATE_MAX=5
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REGISTRATION_REQUEST_MAX=5
RATE_LIMIT_REGISTRATION_STATUS_MAX=30
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000
# Shared Redis service for distributed rate limiting; required for multi-instance production.
REDIS_URL=redis://redis:6379

# Keep unset unless running the guarded legacy registration-password migration.
# ALLOW_CREDENTIAL_MIGRATION=false
