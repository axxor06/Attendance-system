# Copy to server/.env for local development. Never commit a real .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Browser origins. In production use exact HTTPS origins only.
# For LAN development, replace YOUR_PC_LAN_IP with the PC's private IPv4 address.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://YOUR_PC_LAN_IP:5173
# Optional development convenience: allow only HTTP localhost and RFC1918
# origins on ports 5173/3000. Keep false in production.
ALLOW_LAN_ORIGINS=true
TRUST_PROXY_HOPS=0

# MongoDB. Use a TLS-enabled, network-restricted MongoDB deployment in production.
MONGO_URI=mongodb://127.0.0.1:27017/attendance_register
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate two different high-entropy values; do not reuse them elsewhere.
JWT_ACCESS_SECRET=replace-with-a-random-64-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Small grace window for legitimate same-token multi-tab rotation races.
# Keep this short; old-token reuse outside the window revokes the family.
REFRESH_ROTATION_GRACE_MS=1500
# HTTP LAN development: lax + false. Production: usually none + true behind HTTPS.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_DOMAIN=example.edu

# SMTP. Leave unset only if email is not required in a local test environment.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-me
EMAIL_PASS=replace-me
EMAIL_FROM="Attendance System <noreply@example.edu>"

# ImageKit server-side configuration. Never expose IMAGEKIT_PRIVATE_KEY in VITE_* variables.
# IMAGEKIT_PUBLIC_KEY=replace-with-imagekit-public-key
# IMAGEKIT_PRIVATE_KEY=replace-with-imagekit-private-key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# IMAGEKIT_PROFILE_FOLDER=/attendance-register/profiles

OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Rate limiting (per IP, per RATE_LIMIT_WINDOW_MINUTES window).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OTP_GENERATE_MAX=5
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_PASSWORD_CHANGE_MAX=10
RATE_LIMIT_QR_GENERATE_MAX=20
RATE_LIMIT_QR_SCAN_MAX=30
RATE_LIMIT_ATTENDANCE_SUBMIT_MAX=120
RATE_LIMIT_REGISTRATION_REQUEST_MAX=5
RATE_LIMIT_REGISTRATION_STATUS_MAX=30
RATE_LIMIT_PROFILE_PHOTO_MAX=10
RATE_LIMIT_ASSIGNMENT_REQUEST_MAX=8

# Account-aware progressive login protection. A successful login resets the failure state.
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCK_BASE_MS=60000
LOGIN_LOCK_MAX_MS=900000

# Maximum rows allowed in a synchronous PDF/Excel export.
MAX_REPORT_ROWS=5000

# Staging-only timetable root-cause diagnostics. Keep false/unset in production.
# DEBUG_TIMETABLE_CONFLICTS=false
# DIAGNOSTIC_TIMETABLE_IDS=<timetable-or-class-id>,<timetable-or-class-id>

# Set this only for local tests; never set it in production.
DISABLE_RATE_LIMITS=false

# Optional development seed inputs. The seed script requires all three values
# and refuses short/default passwords.
# SEED_ADMIN_NAME=Head Admin
# SEED_ADMIN_EMAIL=admin@college.edu
# SEED_ADMIN_PASSWORD=use-a-unique-12-character-password
# SEED_FACULTY_PASSWORD=use-a-unique-12-character-password
# SEED_STUDENT_PASSWORD=use-a-unique-12-character-password

# Shared distributed rate-limit store. When configured, every backend instance
# must use the same Redis deployment. When omitted, local memory limiting is used
# for development only and is not sufficient for multi-instance production.
# REDIS_URL=redis://127.0.0.1:6379
# Development attempts one bounded connection and then falls back to memory limits.
# Production keeps reconnect support and should use a shared Redis deployment.
REDIS_CONNECT_TIMEOUT_MS=3000

# Student device binding is always enforced for student accounts. The browser
# creates an opaque local device ID and sends it as X-Device-Id. HOD/admins can
# reset a student binding from People; faculty and management remain multi-device.

# One-time migration control for legacy plaintext registration-request records.
# Keep unset unless performing a controlled maintenance migration.
# ALLOW_CREDENTIAL_MIGRATION=false
